#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Open Cloudflare's prefilled token form and store the resulting token.

Usage:
  create-cloudflare-token --account-id ACCOUNT_ID [options]

Options:
  --verify-list-id LIST_ID  Verify against this list instead of configured list
  --name NAME               Prefilled token name (default: cf-redirect)
  --no-open                 Print the form URL instead of opening a browser
  --token-stdin             Read the created token from stdin instead of a prompt
  -h, --help                Show this help

The form grants only Account Filter Lists: Edit for the selected account.
Cloudflare cannot scope this permission to one list. After creating the token
in the browser, paste it at the hidden prompt. cf-redirect verifies and stores
it in the OS keychain; the token is never printed or passed as an argument.
EOF
}

account_id=""
verify_list_id=""
token_name="cf-redirect"
open_browser=true
token_stdin=false

while (($#)); do
  case "$1" in
    --account-id)
      [[ $# -ge 2 ]] || { echo "--account-id requires a value" >&2; exit 2; }
      account_id="$2"
      shift 2
      ;;
    --verify-list-id)
      [[ $# -ge 2 ]] || { echo "--verify-list-id requires a value" >&2; exit 2; }
      verify_list_id="$2"
      shift 2
      ;;
    --name)
      [[ $# -ge 2 ]] || { echo "--name requires a value" >&2; exit 2; }
      token_name="$2"
      shift 2
      ;;
    --no-open)
      open_browser=false
      shift
      ;;
    --token-stdin)
      token_stdin=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[[ "$account_id" =~ ^[[:xdigit:]]{32}$ ]] || { echo "--account-id must be a 32-character hexadecimal ID" >&2; exit 2; }
if [[ -n "$verify_list_id" && ! "$verify_list_id" =~ ^[[:xdigit:]]{32}$ ]]; then
  echo "--verify-list-id must be a 32-character hexadecimal ID" >&2
  exit 2
fi
[[ -n "$token_name" && ${#token_name} -le 120 ]] || { echo "--name must contain 1 to 120 characters" >&2; exit 2; }
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

if [[ -n "${CF_REDIRECT_BIN:-}" ]]; then
  cf_redirect="$CF_REDIRECT_BIN"
elif command -v cf-redirect >/dev/null; then
  cf_redirect="$(command -v cf-redirect)"
elif [[ -x "$(dirname "$0")/../bin/cf-redirect" ]]; then
  cf_redirect="$(cd "$(dirname "$0")/.." && pwd)/bin/cf-redirect"
else
  echo "cf-redirect is required to verify and securely store the created token" >&2
  exit 1
fi
[[ -x "$cf_redirect" ]] || { echo "cf-redirect executable not found: $cf_redirect" >&2; exit 1; }

permission_json='[{"key":"account_rule_lists","type":"edit"}]'
permission_query="$(jq -rn --arg value "$permission_json" '$value | @uri')"
name_query="$(jq -rn --arg value "$token_name" '$value | @uri')"
template_url="https://dash.cloudflare.com/profile/api-tokens?permissionGroupKeys=${permission_query}&accountId=${account_id}&zoneId=all&name=${name_query}"

if [[ "$open_browser" == true ]]; then
  if [[ -n "${CF_REDIRECT_BROWSER:-}" ]]; then
    browser="$CF_REDIRECT_BROWSER"
  elif command -v open >/dev/null; then
    browser="$(command -v open)"
  elif command -v xdg-open >/dev/null; then
    browser="$(command -v xdg-open)"
  else
    echo "No browser opener found; rerun with --no-open" >&2
    echo "$template_url" >&2
    exit 1
  fi
  [[ -x "$browser" ]] || { echo "browser opener is not executable: $browser" >&2; exit 1; }
  "$browser" "$template_url"
  echo "Opened Cloudflare's prefilled API token form." >&2
else
  echo "$template_url"
fi

if [[ "$token_stdin" == true ]]; then
  created_token="$(cat)"
else
  if [[ ! -t 0 && ! -t 1 && ! -t 2 ]]; then
    echo "no terminal available; use --token-stdin" >&2
    exit 1
  fi
  if ! IFS= read -r -s -p "Create the token in Cloudflare, then paste it here: " created_token </dev/tty; then
    echo "could not read from terminal; use --token-stdin" >&2
    exit 1
  fi
  printf '\n' >/dev/tty
fi
created_token="$(printf '%s' "$created_token" | tr -d '\r\n')"
[[ -n "$created_token" ]] || { echo "API token must not be empty" >&2; exit 1; }

login_args=(--account-id "$account_id")
if [[ -n "$verify_list_id" ]]; then
  login_args+=(--list-id "$verify_list_id")
fi
login_args+=(auth login --token-stdin)
if ! printf '%s' "$created_token" | env -u CLOUDFLARE_API_TOKEN \
  "$cf_redirect" "${login_args[@]}"; then
  echo "Token verification or keychain storage failed; revoke the token in Cloudflare" >&2
  exit 1
fi
created_token=""
echo "Cloudflare token verified and stored in the OS keychain."
